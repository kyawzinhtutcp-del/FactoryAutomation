<!DOCTYPE html>
<html>
<head>
    <title>Add Maintenance Record</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-4">
    <h2 class="mb-3">Add New Maintenance Record</h2>
    <form action="/add" method="POST" class="row g-3">
        <div class="col-md-12">
            <label class="form-label fw-bold">Select Machine (Line / Section / Machine Name)</label>
            <select name="machine_id" class="form-select" required>
                <option value="">-- Choose Machine --</option>
                <% machines.forEach(m => { %>
                    <option value="<%= m.machine_id %>" <%= m.machine_id == selectedMachineId ? 'selected' : '' %>>
                        [<%= m.line_name %>] - Section <%= m.machine_section %> : <%= m.machine_name %>
                    </option>
                <% }) %>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Date</label>
            <input type="date" name="maintenance_date" class="form-control" required>
        </div>
        <div class="col-md-6">
            <label class="form-label">Maintenance Type</label>
            <input type="text" name="maintenance_type" class="form-control" placeholder="Replacement / Repair" required>
        </div>
        <div class="col-md-6">
            <label class="form-label">Parts Replaced</label>
            <input type="text" name="parts_replaced" class="form-control">
        </div>
        <div class="col-md-6">
            <label class="form-label">Replaced Quantity</label>
            <input type="number" name="replaced_quantity" class="form-control">
        </div>
        <div class="col-md-6">
            <label class="form-label">Technician / Engineer</label>
            <input type="text" name="technician_engineer" class="form-control" required>
        </div>
        <div class="col-12">
            <label class="form-label">Issue / Task Description</label>
            <textarea name="issue_task" class="form-control" rows="3" required></textarea>
        </div>
        <div class="col-12 mt-3">
            <button type="submit" class="btn btn-primary">Save Record</button>
            <a href="/" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </form>
</body>
</html>